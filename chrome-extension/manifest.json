{
  "manifest_version": 3,
  "name": "Sporfri",
  "version": "1.0.0",
  "description": "Strips tracking and ad parameters (utm_*, fbclid, si, …) from links you copy and open.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "contextMenus", "offscreen", "clipboardWrite", "activeTab"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Copy clean URL of this page",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "commands": {
    "copy-clean-url": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Copy clean URL of the current tab"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["sporfri.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["main-world.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
